{
  "name": "startpage-edge",
  "description": "极简立体搜索起始页 —— 替换 Edge / Chromium 新标签页的起始页扩展",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt -b edge",
    "dev:edge": "wxt -b edge",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build -b edge",
    "build:edge": "wxt build -b edge",
    "build:chrome": "wxt build -b chrome",
    "zip": "wxt zip -b edge",
    "compile": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,svelte,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.1.30",
    "@types/node": "^24.7.0",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^9.38.0",
    "eslint-plugin-svelte": "^3.2.0",
    "fake-indexeddb": "^6.2.2",
    "globals": "^17.13.0",
    "jsdom": "^28.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
